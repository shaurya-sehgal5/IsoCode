generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FINANCE_EXECUTIVE
  CO_FOUNDER
}

enum ImportStatus {
  UPLOADED
  MAPPING_REQUIRED
  PROCESSING
  COMPLETED
  FAILED
}

enum MatchStatus {
  MATCHED
  PARTIAL
  UNMATCHED
  REVIEW_REQUIRED
}

enum ClaimStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model User {
  reviewedAiSuggestions AiMatchSuggestion[] @relation("AiSuggestionReviewer")
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(FINANCE_EXECUTIVE)

  imports        ImportBatch[]
  columnMappings ColumnMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id           String    @id @default(cuid())
  orderNumber  String    @unique
  customerName String?
  orderDate    DateTime?
  orderAmount  Decimal   @db.Decimal(12, 2)
  currency     String    @default("INR")
  status       String    @default("PLACED")

  reconciliationResults ReconciliationResult[]
  aiMatchSuggestions AiMatchSuggestion[]
  returns               ReturnRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderDate])
}

model ImportBatch {
  id            String       @id @default(cuid())
  fileName      String
  fileType      String
  fileSize      Int?
  status        ImportStatus @default(UPLOADED)
  totalRows     Int          @default(0)
  processedRows Int          @default(0)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  columnMappingId String?
  columnMapping   ColumnMapping? @relation(fields: [columnMappingId], references: [id])

  payments PaymentRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ColumnMapping {
  id         String  @id @default(cuid())
  sourceName String
  version    Int
  mapping    Json
  isActive   Boolean @default(true)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  imports ImportBatch[]

  createdAt DateTime @default(now())

  @@unique([createdById, sourceName, version])
}

model PaymentRecord {
  id                    String    @id @default(cuid())
  externalTransactionId String?   @unique
  orderReference        String?
  grossAmount           Decimal   @db.Decimal(12, 2)
  fees                  Decimal   @default(0) @db.Decimal(12, 2)
  netAmount             Decimal   @db.Decimal(12, 2)
  currency              String    @default("INR")
  paymentDate           DateTime?

  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id])

  reconciliationResults ReconciliationResult[]
  aiMatchSuggestions AiMatchSuggestion[]

  createdAt DateTime @default(now())

  @@index([orderReference])
  @@index([paymentDate])
}

model ReconciliationResult {
  id              String      @id @default(cuid())
  matchStatus     MatchStatus @default(UNMATCHED)
  expectedAmount  Decimal?    @db.Decimal(12, 2)
  actualAmount    Decimal?    @db.Decimal(12, 2)
  difference      Decimal?    @db.Decimal(12, 2)
  matchConfidence Float?

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  paymentRecordId String?
  paymentRecord   PaymentRecord? @relation(fields: [paymentRecordId], references: [id])

  claim Claim?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchStatus])
  @@index([paymentRecordId])
}

model Claim {
  id          String      @id @default(cuid())
  claimNumber String      @unique
  title       String
  description String?
  amount      Decimal     @db.Decimal(12, 2)
  status      ClaimStatus @default(OPEN)

  reconciliationResultId String               @unique
  reconciliationResult   ReconciliationResult @relation(fields: [reconciliationResultId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model RateCard {
  id          String   @id @default(cuid())
  gatewayName String   @unique
  feePercent  Decimal  @db.Decimal(5, 2)
  fixedFee    Decimal  @default(0) @db.Decimal(12, 2)
  tcsPercent  Decimal  @default(0) @db.Decimal(5, 2)
  tdsPercent  Decimal  @default(0) @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REFUNDED
  REJECTED
}

model ReturnRecord {
  id              String       @id @default(cuid())
  returnNumber    String       @unique
  orderReference  String
  refundAmount    Decimal      @db.Decimal(12, 2)
  reason          String?
  status          ReturnStatus @default(REQUESTED)
  gatewayRefundId String?      @unique
  refundDate      DateTime?
  orderId         String?
  order           Order?       @relation(fields: [orderId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orderReference])
  @@index([status])
}

enum AiSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model AiMatchSuggestion {
  id               String             @id @default(cuid())
  paymentRecordId  String
  suggestedOrderId String
  confidence       Float
  reason           String
  evidence         Json
  status           AiSuggestionStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?

  paymentRecord  PaymentRecord @relation(fields: [paymentRecordId], references: [id])
  suggestedOrder Order         @relation(fields: [suggestedOrderId], references: [id])
  reviewedBy     User?         @relation("AiSuggestionReviewer", fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([paymentRecordId, suggestedOrderId])
  @@index([status])
  @@index([paymentRecordId])
}